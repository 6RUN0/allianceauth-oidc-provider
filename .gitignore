.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Mutation testing (cosmic-ray) — work-queue sqlite + journals, plus
# the rendered HTML report. All three are regenerable from
# ``cosmic-ray.toml`` + the test suite, so we never commit them.
# The ``.bak_*`` pattern catches the timestamped snapshots that
# ``mutation`` / ``mutation_parallel --reinit`` drops next to the
# active queue so an operator can diff verdicts across sweeps.
mutation.sqlite
mutation.sqlite-*
mutation.sqlite.bak_*
html/

# Translations: .po is the source, .mo is the compiled binary. We
# commit shipped .mo files (under allianceauth_oidc/locale/) so the
# wheel ships compiled catalogues and operators don't need to run
# `compilemessages`. The blanket *.mo ignore still catches stray .mo
# files left around by ad-hoc `django-admin compilemessages` runs in
# other directories. Same idea for the .pot template.
*.mo
*.pot
!allianceauth_oidc/locale/**/*.mo
!allianceauth_oidc/locale/django.pot

