# Deny everything, then re-include what belongs.
# `/*` is anchored to the root, `.*` is not: the second closes dot-named
# paths at every depth (tests/.env), which the first misses.
/*
.*

# --- Package and test sources ---
!/allianceauth_oidc/
!/tests/
!/_nox/
!/noxfile.py
!/scripts/

# --- Docs and assets ---
!/docs/
!/assets/
!/README.md
!/README.ru.md
!/CHANGELOG.md
!/CHANGELOG.ru.md
!/CLAUDE.md
!/LICENSE

# --- Build and dependency manifests ---
!/pyproject.toml
!/uv.lock
!/Makefile

# --- Tooling config ---
!/.editorconfig
!/.gitattributes
!/.gitignore
!/tests/conformance/tls/.gitignore
!/.dockerignore
!/.prettierignore
!/.prettierrc
!/.pre-commit-config.yaml
!/.yamllint
!/.rumdl.toml
!/.vale.ini
!/.codespell-ignore.txt
!/.secrets.baseline
!/.semgrep/
!/.github/
!/.tx/
!/cosmic-ray.toml
!/tach.toml

# --- Vale styles ---
# `vale sync` downloads external packages into sibling directories here;
# only the project's own vocabulary is committed.
!/styles/
/styles/*
!/styles/config/

# --- Python build output inside allowed directories ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/

# --- Translations ---
# .po is the source; the shipped .mo files are committed so the wheel
# carries compiled catalogues and operators need no `compilemessages`.
*.mo
*.pot
!/allianceauth_oidc/locale/**/*.mo
!/allianceauth_oidc/locale/django.pot

# --- Secrets and local overrides inside allowed directories ---
*.pem
*.key
local_settings.py
!/tests/oidc-test.key

# --- Editor and merge artifacts inside allowed directories ---
*~
*.swp
*.swo
*.orig
*.rej

# --- Generated output inside allowed directories ---
/docs/_build/
# Trailing `*` also catches rotated names (`django.log.1`).
*.log*
