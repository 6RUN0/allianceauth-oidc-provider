msgid "Skipped %(count)d application(s) without backchannel_logout_uri."
msgstr ""

#, python-format
msgid ""
"Skipped %(count)d application(s) with backchannel_logout_on_revoke_only=True "
"(only fires on real user-revoke events; not on admin test)."
msgstr ""
"Пропущено %(count)d приложений(я) с backchannel_logout_on_revoke_only=True "
"(срабатывает только на реальные revoke-события пользователя, не на admin-"
