# Default: detect text files and normalize EOL to LF on commit.
# Pairs with .editorconfig (which sets end_of_line = lf).
* text=auto eol=lf

# Source
*.py        text diff=python
*.pyi       text diff=python
*.toml      text
*.cfg       text
*.ini       text
*.yml       text
*.yaml      text
*.json      text
*.md        text diff=markdown
*.html      text diff=html
*.css       text diff=css
*.txt       text
*.rst       text

# Shell / Make
*.sh        text eol=lf
Makefile    text eol=lf
*.mk        text eol=lf

# RSA test key is PEM (ASCII armored) — keep as text.
*.key       text eol=lf
*.pem       text eol=lf

# Translations
# .po is plain text but it's mostly machine-managed; hide from language stats
# and language-aware diffs.
*.po        text linguist-detectable=false
*.pot       text linguist-detectable=false
# .mo is a compiled binary catalog — should never be in this repo, but if it is.
*.mo        binary linguist-generated=true

# Lockfiles: text, but mark as generated so GitHub collapses diffs in PRs and
# does not count them in language statistics.
uv.lock     text linguist-generated=true
poetry.lock text linguist-generated=true

# Binary assets (none currently tracked, but lock the rules for the future).
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       text
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.tgz       binary
*.whl       binary

# Files that should not be included in `git archive` tarballs
# (e.g. GitHub source-code-zip on a release tag). Dev/CI infra only.
.github/             export-ignore
.tx/                 export-ignore
.editorconfig        export-ignore
.gitattributes       export-ignore
.gitignore           export-ignore
.pre-commit-config.yaml export-ignore
.prettierignore      export-ignore
.prettierrc          export-ignore
.coveragerc          export-ignore
.tox/                export-ignore
.mypy_cache/         export-ignore
htmlcov/             export-ignore
coverage.xml         export-ignore
.coverage            export-ignore
