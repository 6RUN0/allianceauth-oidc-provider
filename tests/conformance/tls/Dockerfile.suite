# Extends the upstream OIDC Conformance Suite image with our self-signed
# CA imported into Java's truststore. The suite's HttpClient validates
# the provider's certificate against this truststore when fetching the
# discovery document and other OIDC endpoints.
#
# The base image's ENTRYPOINT exec's ``java`` directly without going
# through ``__cacert_entrypoint.sh``, so the eclipse-temurin
# auto-import path (``USE_SYSTEM_CA_CERTS``) is bypassed. Importing at
# build time is the cleanest fix — it survives container restarts and
# avoids fragile entrypoint juggling.
ARG IMAGE_TAG=release-v5.1.45
FROM registry.gitlab.com/openid/conformance-suite:${IMAGE_TAG}

# Build context is ``tls/`` so the CA cert is alongside this file.
COPY ca.crt /usr/local/share/ca-certificates/conformance-provider-ca.crt

# Two-pronged trust install:
# 1. ``$JAVA_HOME/lib/security/cacerts`` is the standard JKS keystore
#    used by Spring HttpClient when the suite fetches the discovery
#    document, JWKS, and so on. ``changeit`` is the immutable JDK
#    default password. The stable alias makes the import idempotent —
#    keytool refuses duplicates by default, hence the
#    cleanup-on-conflict wrapper.
# 2. The suite's headless Chromium (driven by Selenium for
#    browser-required modules: login form fill, consent click) uses
#    the **Linux** trust store, not Java's. ``update-ca-certificates``
#    folds the cert from ``/usr/local/share/ca-certificates/`` into
#    ``/etc/ssl/certs/ca-certificates.crt``; without this step
#    Chromium hits the provider's self-signed cert as untrusted and
#    sits on the browser's interstitial-error page until the
#    per-module 5-minute poll timeout fires.
RUN update-ca-certificates \
    && keytool -delete -alias allianceauth-oidc-provider-ca \
        -keystore "$JAVA_HOME/lib/security/cacerts" \
        -storepass changeit 2>/dev/null || true \
    && keytool -import -trustcacerts \
        -alias allianceauth-oidc-provider-ca \
        -file /usr/local/share/ca-certificates/conformance-provider-ca.crt \
        -keystore "$JAVA_HOME/lib/security/cacerts" \
        -storepass changeit -noprompt

# HtmlUnit is pinned at 4.11.1 through the suite's Spring Boot BOM in
# every release up to at least v5.2.1, so a jar swap is not an option
# anyway (replacing it inside the Spring Boot fat jar corrupts the
# archive). What changed in release-v5.1.44 (work item 1827): the
# suite now sets a 60s HTTP timeout on the headless browser's
# WebClient. Before that fix a connection the provider accepted but
# never answered blocked the WebRunner thread forever, which is what
# used to present as non-deterministic TIMEOUTs across the
# browser-driven basic-cert modules.
