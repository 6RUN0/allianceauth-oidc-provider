#
# Provider image for OIDC Conformance Suite.
#
# Pragmatic minimal image (option (c) from the design doc): rather
# than reproduce a full Alliance Auth production deployment, we
# install the project deps via uv and use the same ``test_settingsAA4``
# the test suite uses, swapping in ``conformance_settings`` for the
# bits the suite needs (HTTPS-aware iss, public ALLOWED_HOSTS, …).
#
# Heavy on-image lifting:
# - System packages required by AA's wheel deps (libffi, libssl).
# - uv for fast dependency resolution.
# - Sqlite (default) is fine for the conformance run; no Postgres
#   needed.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
  PYTHONUNBUFFERED=1 \
  DJANGO_SETTINGS_MODULE=tests.conformance.conformance_settings \
  PIP_DISABLE_PIP_VERSION_CHECK=1 \
  UV_LINK_MODE=copy

# System deps:
#   build-essential, libffi/libssl/xml*           — generic native wheels
#   pkg-config + default-libmysqlclient-dev       — required by AA's
#       transitive ``mysqlclient`` dep, which has no wheels and
#       compiles against MySQL client headers even when the runtime
#       DB is SQLite.
RUN \
  set -eux; \
  apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update; \
  apt-get -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold install -y --no-install-recommends --no-install-suggests \
  build-essential \
  ca-certificates \
  curl \
  default-libmysqlclient-dev \
  libffi-dev \
  libssl-dev \
  libxml2-dev \
  libxslt1-dev \
  pkg-config; \
  apt-get clean; \
  rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy lock + project metadata first so the dep layer is reusable
# across source-only changes. ``LICENSE`` is required because
# pyproject.toml declares ``license = { file = "LICENSE" }`` and the
# flit_core build backend reads it; ``README.md`` is the project's
# ``readme`` source.
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY allianceauth_oidc ./allianceauth_oidc

# Granular ``tests/`` slice — the conformance provider runtime needs
# only Django settings + URLConf + the fakeredis hook + the RSA key.
# ``_mariadb_container`` rides along because ``test_settingsAA4``
# imports its settings half at module scope (stdlib-only; the
# ``AA_OIDC_TEST_DB`` gate is unset here, so it is a no-op that keeps
# sqlite). Excluded by omission: ``tests/test_*.py`` (the unit-test
# suite, ~50 files run via ``nox -s tests`` on the host, never in this
# container) and ``tests/_factories.py`` / ``_jwt_helpers.py`` /
# ``_oidc_testcase.py`` (test fixtures and helpers with the same
# host-only lifecycle). The slice is drift-gated by
# ``tests/unit/test_conformance_dockerfile.py``, which recomputes the
# import closure of the container entrypoints against this slice.
COPY tests/__init__.py tests/_fakeredis.py tests/_mariadb_container.py \
     tests/celery.py tests/oidc-test.key tests/test_settingsAA4.py \
     tests/urls.py tests/views.py \
     ./tests/

# Conformance runtime — provider-side only. ``runner/`` is the
# *host-side* plan driver (``run_plan.py`` + ``aggregate_summaries.py``
# + the orchestrator/client/filtering/summary modules); the only
# runner module the container needs is ``runner/config.py``, which
# ``seed.py`` imports for the credential constants.
COPY tests/conformance/conformance_settings.py \
     tests/conformance/entrypoint.sh \
     tests/conformance/seed.py \
     tests/conformance/wsgi.py \
     ./tests/conformance/
COPY tests/conformance/runner/__init__.py \
     tests/conformance/runner/config.py \
     ./tests/conformance/runner/
COPY tests/conformance/tls/ca.crt \
     tests/conformance/tls/provider.crt \
     tests/conformance/tls/provider.key \
     ./tests/conformance/tls/

ARG UV_VERSION=0.11.11

RUN \
  set -eux; \
  pip install --no-cache-dir --disable-pip-version-check --root-user-action=ignore --progress-bar off uv==${UV_VERSION}; \
  uv --version; \
  uv sync --group aa5 --frozen; \
  uv pip install --no-cache "gunicorn>=23.0,<24"

EXPOSE 8443

ENTRYPOINT ["/app/tests/conformance/entrypoint.sh"]
